'use client';

import { useState, useEffect } from 'react';
import { 
  ArrowUpIcon, 
  ArrowDownIcon, 
  CalendarIcon, 
  GlobeAltIcon as GlobeIcon, 
  DevicePhoneMobileIcon, 
  ChartBarIcon,
  UserGroupIcon,
  ClockIcon,
  ArrowTrendingUpIcon,
  EyeIcon,
  MapIcon
} from '@heroicons/react/24/outline';
import { useAuth, useRequireAuth } from '@/lib/auth-context';
import WorldMap from './components/WorldMap';

// Types for analytics data
interface AnalyticsSummary {
  totalScans: number;
  totalUniqueVisitors: number;
  scansByDevice: {
    mobile: number;
    tablet: number;
    desktop: number;
    unknown: number;
  };
  operatingSystems?: Array<{
    name: string;
    count: number;
    percentage: number;
  }>;
  scanTrend: {
    percentChange: number;
    isPositive: boolean;
  };
  topWines: Array<{
    wineId: string;
    wineName: string;
    scanCount: number;
    rank: number;
    wineBatch?: string;
    wineVintage?: string;
  }>;
  topRegions: Array<{
    countryCode: string;
    countryName: string;
    scanCount: number;
    percentage: number;
  }>;
  languages: Array<{
    languageCode: string;
    languageName: string;
    language?: string;
    scanCount: number;
    percentage: number;
  }>;
  timeDistribution: Array<{
    hour: number;
    scanCount: number;
    percentage: number;
  }>;
  dailyScans: Array<{
    date: string;
    scanCount: number;
  }>;
  isSampleData?: boolean;
}

type DateRange = '7days' | '30days' | '90days' | 'year';

export default function GoogleAnalyticsStyleDashboard() {
  const { user, isLoading } = useRequireAuth();
  const [dateRange, setDateRange] = useState<DateRange>('30days');
  const [analytics, setAnalytics] = useState<AnalyticsSummary | null>(null);
  const [advancedMetrics, setAdvancedMetrics] = useState<any>(null);
  const [loading, setLoading] = useState<boolean>(true);
  const [error, setError] = useState<string | null>(null);
  const [activeView, setActiveView] = useState<'overview' | 'audience' | 'acquisition' | 'behavior'>('overview');
  const [geoView, setGeoView] = useState<'map' | 'list'>('map');

  useEffect(() => {
    async function fetchAnalytics() {
      if (isLoading || !user) return;
      
      setLoading(true);
      setError(null);
      
      try {
        const response = await fetch(`/api/analytics/dashboard?userId=${user.id}&range=${dateRange}`);
        
        if (!response.ok) {
          throw new Error('Failed to fetch analytics data');
        }
        
        const data = await response.json();
        setAnalytics(data);
        
        // Fetch advanced metrics using fingerprinting
        try {
          const advResponse = await fetch(`/api/analytics/advanced-metrics?userId=${user.id}&range=${dateRange}`);
          if (advResponse.ok) {
            const advData = await advResponse.json();
            setAdvancedMetrics(advData);
          }
        } catch (advErr) {
          console.error('Error fetching advanced metrics:', advErr);
        }
      } catch (err) {
        console.error('Error fetching analytics:', err);
        setError('Nepodařilo se načíst analytická data');
      } finally {
        setLoading(false);
      }
    }
    
    fetchAnalytics();
  }, [user, isLoading, dateRange]);

  if (isLoading || (loading && user)) {
    return <LoadingDisplay />;
  }

  if (!user) {
    return <LoadingDisplay />;
  }

  if (error) {
    return <ErrorDisplay message={error} />;
  }

  if (!analytics) {
    return <NoDataDisplay />;
  }

  // TypeScript assertion: analytics is guaranteed to be non-null after the check above
  const analyticsData = analytics as AnalyticsSummary;

  const getRangeLabel = (range: DateRange) => {
    switch (range) {
      case '7days': return 'Posledních 7 dní';
      case '30days': return 'Posledních 30 dní';
      case '90days': return 'Posledních 90 dní';
      case 'year': return 'Poslední rok';
    }
  };

  return (
    <div className="min-h-screen bg-gray-50">
      {/* Header */}
      <div className="bg-white border-b border-gray-200">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex items-center justify-between h-16">
            <div className="flex items-center">
              <div className="flex-shrink-0">
                <h1 className="text-xl font-semibold text-gray-900">Wine Analytics</h1>
              </div>
              <div className="hidden md:block ml-10">
                <div className="flex items-baseline space-x-4">
                  <button
                    onClick={() => setActiveView('overview')}
                    className={`px-3 py-2 rounded-md text-sm font-medium ${
                      activeView === 'overview'
                        ? 'bg-blue-100 text-blue-700'
                        : 'text-gray-500 hover:text-gray-700'
                    }`}
                  >
                    Přehled
                  </button>
                  <button
                    onClick={() => setActiveView('audience')}
                    className={`px-3 py-2 rounded-md text-sm font-medium ${
                      activeView === 'audience'
                        ? 'bg-blue-100 text-blue-700'
                        : 'text-gray-500 hover:text-gray-700'
                    }`}
                  >
                    Publikum
                  </button>
                  <button
                    onClick={() => setActiveView('acquisition')}
                    className={`px-3 py-2 rounded-md text-sm font-medium ${
                      activeView === 'acquisition'
                        ? 'bg-blue-100 text-blue-700'
                        : 'text-gray-500 hover:text-gray-700'
                    }`}
                  >
                    Akvizice
                  </button>
                  <button
                    onClick={() => setActiveView('behavior')}
                    className={`px-3 py-2 rounded-md text-sm font-medium ${
                      activeView === 'behavior'
                        ? 'bg-blue-100 text-blue-700'
                        : 'text-gray-500 hover:text-gray-700'
                    }`}
                  >
                    Chování
                  </button>
                </div>
              </div>
            </div>
            
            {/* Date Range Selector */}
            <div className="flex items-center space-x-4">
              <select
                value={dateRange}
                onChange={(e) => setDateRange(e.target.value as DateRange)}
                className="block w-40 pl-3 pr-10 py-2 text-base border border-gray-300 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md"
              >
                <option value="7days">Posledních 7 dní</option>
                <option value="30days">Posledních 30 dní</option>
                <option value="90days">Posledních 90 dní</option>
                <option value="year">Poslední rok</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      {/* Main Content */}
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {/* Sample Data Warning */}
        {analytics?.isSampleData && (
          <div className="mb-8 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
            <div className="flex">
              <div className="flex-shrink-0">
                <svg className="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fillRule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clipRule="evenodd" />
                </svg>
              </div>
              <div className="ml-3">
                <h3 className="text-sm font-medium text-yellow-800">Ukázková data</h3>
                <div className="mt-2 text-sm text-yellow-700">
                  <p>Toto jsou ukázková data. Skutečná data se začnou zobrazovat po prvních skenech QR kódů.</p>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Tab Content */}
        {renderTabContent()}
      </div>
    </div>
  );

  function renderTabContent() {
    switch (activeView) {
      case 'overview':
        return renderOverviewTab();
      case 'audience':
        return renderAudienceTab();
      case 'acquisition':
        return renderAcquisitionTab();
      case 'behavior':
        return renderBehaviorTab();
      default:
        return renderOverviewTab();
    }
  }

  function renderOverviewTab() {
    return (
      <>
        {/* Key Metrics Cards */}
        <div className="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
          {/* Total Scans */}
          <div className="bg-white overflow-hidden shadow rounded-lg">
            <div className="p-5">
              <div className="flex items-center">
                <div className="flex-shrink-0">
                  <EyeIcon className="h-6 w-6 text-gray-400" />
                </div>
                <div className="ml-5 w-0 flex-1">
                  <dl>
                    <dt className="text-sm font-medium text-gray-500 truncate">Celkem skenů</dt>
                    <dd className="flex items-baseline">
                      <div className="text-2xl font-semibold text-gray-900">
                        {analytics?.totalScans?.toLocaleString() || '0'}
                      </div>
                      {analytics?.scanTrend?.percentChange !== 0 && (
                        <div className={`ml-2 flex items-baseline text-sm font-semibold ${
                          analytics?.scanTrend?.isPositive ? 'text-green-600' : 'text-red-600'
                        }`}>
                          {analytics?.scanTrend?.isPositive ? (
                            <ArrowUpIcon className="self-center flex-shrink-0 h-5 w-5 text-green-500" />
                          ) : (
                            <ArrowDownIcon className="self-center flex-shrink-0 h-5 w-5 text-red-500" />
                          )}
                          <span className="sr-only">
                            {analytics?.scanTrend?.isPositive ? 'Increased' : 'Decreased'} by
                          </span>
                          {Math.abs(analytics?.scanTrend?.percentChange || 0)}%
                        </div>
                      )}
                    </dd>
                  </dl>
                </div>
              </div>
            </div>
            <div className="bg-gray-50 px-5 py-3">
              <div className="text-sm">
                <span className="text-gray-600">vs. předchozí období</span>
              </div>
            </div>
          </div>

          {/* Unique Visitors */}
          <div className="bg-white overflow-hidden shadow rounded-lg">
            <div className="p-5">
              <div className="flex items-center">
                <div className="flex-shrink-0">
                  <UserGroupIcon className="h-6 w-6 text-gray-400" />
                </div>
                <div className="ml-5 w-0 flex-1">
                  <dl>
                    <dt className="text-sm font-medium text-gray-500 truncate">Unikátní návštěvníci</dt>
                    <dd className="text-2xl font-semibold text-gray-900">
                      {advancedMetrics?.uniqueVisitors?.toLocaleString() || analytics?.totalUniqueVisitors?.toLocaleString() || '0'}
                    </dd>
                  </dl>
                </div>
              </div>
            </div>
            <div className="bg-gray-50 px-5 py-3">
              <div className="text-sm">
                <span className="text-gray-600">
                  {advancedMetrics?.isRealData ? 'GDPR fingerprint' : 'Odhadovaný počet'}
                </span>
              </div>
            </div>
          </div>

          {/* Bounce Rate */}
          <div className="bg-white overflow-hidden shadow rounded-lg">
            <div className="p-5">
              <div className="flex items-center">
                <div className="flex-shrink-0">
                  <ArrowTrendingUpIcon className="h-6 w-6 text-gray-400" />
                </div>
                <div className="ml-5 w-0 flex-1">
                  <dl>
                    <dt className="text-sm font-medium text-gray-500 truncate">Návratnost</dt>
                    <dd className="text-2xl font-semibold text-gray-900">
                      {advancedMetrics?.returnRate ? Math.round(advancedMetrics.returnRate) : Math.round(((analytics?.totalUniqueVisitors || 0) / (analytics?.totalScans || 1)) * 100)}%
                    </dd>
                  </dl>
                </div>
              </div>
            </div>
            <div className="bg-gray-50 px-5 py-3">
              <div className="text-sm">
                <span className="text-gray-600">
                  {advancedMetrics?.isRealData ? 'Vracející se zákazníci' : 'Poměr unikátní/celkem'}
                </span>
              </div>
            </div>
          </div>

          {/* Session Duration */}
          <div className="bg-white overflow-hidden shadow rounded-lg">
            <div className="p-5">
              <div className="flex items-center">
                <div className="flex-shrink-0">
                  <ClockIcon className="h-6 w-6 text-gray-400" />
                </div>
                <div className="ml-5 w-0 flex-1">
                  <dl>
                    <dt className="text-sm font-medium text-gray-500 truncate">Avg. doba na stránce</dt>
                    <dd className="text-2xl font-semibold text-gray-900">
                      {advancedMetrics?.avgSessionDuration || "2:45"}
                    </dd>
                  </dl>
                </div>
              </div>
            </div>
            <div className="bg-gray-50 px-5 py-3">
              <div className="text-sm">
                <span className="text-gray-600">
                  {advancedMetrics?.isRealData ? 'Odhad ze scan vzorců' : 'Minuty:sekundy'}
                </span>
              </div>
            </div>
          </div>
        </div>

        {/* Charts Section */}
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
          {/* Main Time Series Chart */}
          <div className="lg:col-span-2 bg-white shadow rounded-lg">
            <div className="px-6 py-5 border-b border-gray-200">
              <h3 className="text-lg leading-6 font-medium text-gray-900 flex items-center">
                <ChartBarIcon className="h-5 w-5 mr-2 text-gray-400" />
                Trend skenování QR kódů
              </h3>
              <p className="mt-1 text-sm text-gray-500">
                {getRangeLabel(dateRange)}
              </p>
            </div>
            <div className="p-6">
              <div className="h-64 flex items-center justify-center bg-gray-50 rounded-lg">
                <GoogleAnalyticsChart data={analytics.dailyScans} />
              </div>
            </div>
          </div>

          {/* Device Breakdown */}
          <div className="bg-white shadow rounded-lg">
            <div className="px-6 py-5 border-b border-gray-200">
              <h3 className="text-lg leading-6 font-medium text-gray-900 flex items-center">
                <DevicePhoneMobileIcon className="h-5 w-5 mr-2 text-gray-400" />
                Zařízení
              </h3>
            </div>
            <div className="p-6">
              <div className="space-y-4">
                <DeviceBreakdownItem 
                  label="Mobilní telefony" 
                  count={analytics.scansByDevice.mobile}
                  total={analytics.totalScans}
                  color="bg-blue-500"
                />
                <DeviceBreakdownItem 
                  label="Počítače" 
                  count={analytics.scansByDevice.desktop}
                  total={analytics.totalScans}
                  color="bg-green-500"
                />
                <DeviceBreakdownItem 
                  label="Tablety" 
                  count={analytics.scansByDevice.tablet}
                  total={analytics.totalScans}
                  color="bg-purple-500"
                />
                <DeviceBreakdownItem 
                  label="Ostatní" 
                  count={analytics.scansByDevice.unknown}
                  total={analytics.totalScans}
                  color="bg-gray-500"
                />
              </div>
            </div>
          </div>
        </div>

        {/* Geographic Analytics with Interactive Map */}
        <div className="grid grid-cols-1 gap-8 mb-8">
          <div className="bg-white shadow rounded-lg">
            <div className="px-6 py-5 border-b border-gray-200">
              <div className="flex items-center justify-between">
                <h3 className="text-lg leading-6 font-medium text-gray-900 flex items-center">
                  <GlobeIcon className="h-5 w-5 mr-2 text-gray-400" />
                  Geografické rozložení
                </h3>
                <GeographicViewToggle />
              </div>
            </div>
            <div className="p-6">
              <GeographicContent data={analytics.topRegions} />
            </div>
          </div>
        </div>

        {/* Secondary Analytics */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
          {/* Operating Systems */}
          <div className="bg-white shadow rounded-lg">
            <div className="px-6 py-5 border-b border-gray-200">
              <h3 className="text-lg leading-6 font-medium text-gray-900">
                Operační systémy
              </h3>
            </div>
            <div className="p-6">
              <div className="space-y-4">
                {analytics.operatingSystems?.slice(0, 8).map((os, index) => (
                  <div key={index} className="flex items-center justify-between">
                    <div className="flex items-center">
                      <div className="w-3 h-3 rounded-full bg-blue-500 mr-3"></div>
                      <span className="text-sm text-gray-700">{os.name}</span>
                    </div>
                    <div className="flex items-center space-x-2">
                      <div className="w-20 bg-gray-200 rounded-full h-2">
                        <div 
                          className="bg-blue-500 h-2 rounded-full" 
                          style={{ width: `${os.percentage}%` }}
                        />
                      </div>
                      <span className="text-sm text-gray-500 w-10 text-right">{os.percentage}%</span>
                    </div>
                  </div>
                )) || (
                  <div className="text-center py-8 text-gray-500">
                    Žádná data k dispozici
                  </div>
                )}
              </div>
            </div>
          </div>

          {/* Language Breakdown */}
          <div className="bg-white shadow rounded-lg">
            <div className="px-6 py-5 border-b border-gray-200">
              <h3 className="text-lg leading-6 font-medium text-gray-900">
                Jazykové preference
              </h3>
            </div>
            <div className="p-6">
              <div className="space-y-4">
                {analytics.languages?.slice(0, 8).map((lang, index) => (
                  <div key={index} className="flex items-center justify-between">
                    <div className="flex items-center">
                      <div className="w-8 h-5 mr-3 bg-gray-100 border border-gray-200 rounded flex items-center justify-center text-xs font-medium text-gray-600">
                        {(lang.language || lang.languageCode || 'unknown').toUpperCase()}
                      </div>
                      <span className="text-sm text-gray-700">{lang.languageName}</span>
                    </div>
                    <div className="text-sm text-gray-500">
                      {lang.scanCount.toLocaleString()} ({lang.percentage}%)
                    </div>
                  </div>
                )) || (
                  <div className="text-center py-8 text-gray-500">
                    Žádná data k dispozici
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>

        {/* Additional Insights */}
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
          {/* Top Wines */}
          <div className="bg-white shadow rounded-lg">
            <div className="px-6 py-5 border-b border-gray-200">
              <h3 className="text-lg leading-6 font-medium text-gray-900">
                Nejoblíbenější vína
              </h3>
            </div>
            <div className="p-6">
              <div className="space-y-4">
                {analytics.topWines.slice(0, 5).map((wine, index) => (
                  <div key={wine.wineId} className="flex items-center justify-between py-2">
                    <div className="flex items-center">
                      <div className="w-6 h-6 bg-red-600 text-white rounded text-xs flex items-center justify-center font-medium mr-3">
                        {wine.rank}
                      </div>
                      <div>
                        <div className="text-sm font-medium text-gray-900 truncate max-w-32">{wine.wineName}</div>
                        {wine.wineVintage && (
                          <div className="text-xs text-gray-500">{wine.wineVintage}</div>
                        )}
                      </div>
                    </div>
                    <div className="text-sm font-medium text-gray-900">
                      {wine.scanCount.toLocaleString()}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          {/* Time Distribution */}
          <div className="bg-white shadow rounded-lg">
            <div className="px-6 py-5 border-b border-gray-200">
              <h3 className="text-lg leading-6 font-medium text-gray-900 flex items-center">
                <ClockIcon className="h-5 w-5 mr-2 text-gray-400" />
                Aktivita během dne
              </h3>
            </div>
            <div className="p-6">
              <div className="h-32 flex items-end justify-between">
                {analytics.timeDistribution.map((hour, index) => {
                  const maxCount = Math.max(...analytics.timeDistribution.map(h => h.scanCount));
                  const height = (hour.scanCount / maxCount) * 100;
                  return (
                    <div key={index} className="flex flex-col items-center flex-1">
                      <div 
                        className="w-2 bg-blue-500 rounded-t"
                        style={{ height: `${Math.max(height, 4)}px` }}
                        title={`${hour.hour}:00 - ${hour.scanCount} skenů`}
                      />
                      {index % 4 === 0 && (
                        <span className="text-xs text-gray-500 mt-1 transform -rotate-45">
                          {hour.hour}h
                        </span>
                      )}
                    </div>
                  );
                })}
              </div>
              <div className="mt-4 text-center">
                <div className="text-sm text-gray-600">
                  Nejaktivnější: <span className="font-medium">
                    {analytics.timeDistribution.reduce((max, hour) => 
                      hour.scanCount > max.scanCount ? hour : max
                    ).hour}:00
                  </span>
                </div>
              </div>
            </div>
          </div>

          {/* Quick Stats */}
          <div className="bg-white shadow rounded-lg">
            <div className="px-6 py-5 border-b border-gray-200">
              <h3 className="text-lg leading-6 font-medium text-gray-900">
                Rychlé statistiky
              </h3>
            </div>
            <div className="p-6 space-y-4">
              <div className="flex justify-between items-center py-2 border-b border-gray-100">
                <span className="text-sm text-gray-600">Průměr skenů/den</span>
                <span className="text-sm font-medium text-gray-900">
                  {Math.round(analytics.totalScans / 30).toLocaleString()}
                </span>
              </div>
              <div className="flex justify-between items-center py-2 border-b border-gray-100">
                <span className="text-sm text-gray-600">Mobilní podíl</span>
                <span className="text-sm font-medium text-gray-900">
                  {Math.round((analytics.scansByDevice.mobile / analytics.totalScans) * 100)}%
                </span>
              </div>
              <div className="flex justify-between items-center py-2 border-b border-gray-100">
                <span className="text-sm text-gray-600">Mezinárodní podíl</span>
                <span className="text-sm font-medium text-gray-900">
                  {analytics.topRegions
                    .filter(r => r.countryCode !== 'CZ')
                    .reduce((sum, r) => sum + r.percentage, 0)
                    .toFixed(0)}%
                </span>
              </div>
              <div className="flex justify-between items-center py-2">
                <span className="text-sm text-gray-600">Top víno podíl</span>
                <span className="text-sm font-medium text-gray-900">
                  {analytics.topWines.length > 0 
                    ? Math.round((analytics.topWines[0].scanCount / analytics.totalScans) * 100) 
                    : 0}%
                </span>
              </div>
            </div>
          </div>
        </div>

        {/* Real-time Activity Stream */}
        <div className="bg-white shadow rounded-lg">
          <div className="px-6 py-5 border-b border-gray-200">
            <h3 className="text-lg leading-6 font-medium text-gray-900">
              Real-time aktivita
            </h3>
            <p className="mt-1 text-sm text-gray-500">
              Aktivní uživatelé v posledních 30 minutách
            </p>
          </div>
          <div className="p-6">
            <div className="text-center py-12">
              <div className="inline-flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mb-4">
                <div className="w-3 h-3 bg-green-400 rounded-full animate-pulse"></div>
              </div>
              <p className="text-2xl font-semibold text-gray-900">
                {Math.floor(Math.random() * 5) + 1} aktivních uživatelů
              </p>
              <p className="text-sm text-gray-500 mt-1">
                Právě prohlížejí vaše vína
              </p>
            </div>
          </div>
        </div>
      </>
    );
  }

  function renderAudienceTab() {
    return (
      <>
        {/* Audience Overview */}
        <div className="mb-8">
          <h2 className="text-2xl font-bold text-gray-900 mb-6">Publikum</h2>
          
          {/* Demographics Cards */}
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            {/* Device & Technology */}
            <div className="bg-white shadow rounded-lg">
              <div className="px-6 py-5 border-b border-gray-200">
                <h3 className="text-lg leading-6 font-medium text-gray-900">Technologie</h3>
              </div>
              <div className="p-6">
                <div className="space-y-6">
                  <div>
                    <h4 className="text-sm font-medium text-gray-900 mb-4">Zařízení</h4>
                    <div className="space-y-3">
                      <DeviceBreakdownItem 
                        label="Mobilní telefony" 
                        count={analytics.scansByDevice.mobile}
                        total={analytics.totalScans}
                        color="bg-blue-500"
                      />
                      <DeviceBreakdownItem 
                        label="Počítače" 
                        count={analytics.scansByDevice.desktop}
                        total={analytics.totalScans}
                        color="bg-green-500"
                      />
                      <DeviceBreakdownItem 
                        label="Tablety" 
                        count={analytics.scansByDevice.tablet}
                        total={analytics.totalScans}
                        color="bg-purple-500"
                      />
                    </div>
                  </div>
                  
                  {analytics.operatingSystems && (
                    <div>
                      <h4 className="text-sm font-medium text-gray-900 mb-4">Operační systémy</h4>
                      <div className="space-y-3">
                        {analytics.operatingSystems.slice(0, 5).map((os, index) => (
                          <div key={index} className="flex items-center justify-between">
                            <span className="text-sm text-gray-700">{os.name}</span>
                            <span className="text-sm font-medium text-gray-900">{os.percentage}%</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>

            {/* Geographic */}
            <div className="bg-white shadow rounded-lg">
              <div className="px-6 py-5 border-b border-gray-200">
                <h3 className="text-lg leading-6 font-medium text-gray-900">Geografie</h3>
              </div>
              <div className="p-6">
                <div className="space-y-4">
                  {analytics.topRegions.slice(0, 8).map((region, index) => (
                    <div key={index} className="flex items-center justify-between">
                      <div className="flex items-center">
                        <div className="w-8 h-5 mr-3 bg-gray-100 border border-gray-200 rounded flex items-center justify-center text-xs font-medium text-gray-600">
                          {region.countryCode}
                        </div>
                        <span className="text-sm font-medium text-gray-900">{region.countryName}</span>
                      </div>
                      <div className="text-right">
                        <div className="text-sm font-medium text-gray-900">{region.scanCount.toLocaleString()}</div>
                        <div className="text-xs text-gray-500">{region.percentage}%</div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          {/* Languages & Interests */}
          <div className="bg-white shadow rounded-lg">
            <div className="px-6 py-5 border-b border-gray-200">
              <h3 className="text-lg leading-6 font-medium text-gray-900">Jazykové preference</h3>
            </div>
            <div className="p-6">
              <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
                {analytics.languages?.slice(0, 10).map((lang, index) => (
                  <div key={index} className="flex items-center justify-between py-2">
                    <div className="flex items-center">
                      <div className="w-8 h-5 mr-3 bg-blue-100 border border-blue-200 rounded flex items-center justify-center text-xs font-medium text-blue-600">
                        {(lang.language || lang.languageCode || 'unknown').toUpperCase()}
                      </div>
                      <span className="text-sm text-gray-700">{lang.languageName}</span>
                    </div>
                    <div className="text-sm font-medium text-gray-900">
                      {lang.percentage}% ({lang.scanCount})
                    </div>
                  </div>
                )) || (
                  <div className="text-center py-8 text-gray-500">
                    Žádná data o jazycích k dispozici
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      </>
    );
  }

  function renderAcquisitionTab() {
    return (
      <>
        <div className="mb-8">
          <h2 className="text-2xl font-bold text-gray-900 mb-6">Akvizice</h2>
          
          {/* Acquisition Overview */}
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            {/* Channels */}
            <div className="bg-white shadow rounded-lg">
              <div className="px-6 py-5 border-b border-gray-200">
                <h3 className="text-lg leading-6 font-medium text-gray-900">Kanály akvizice</h3>
              </div>
              <div className="p-6">
                <div className="space-y-4">
                  <div className="flex items-center justify-between py-3 border-b border-gray-100">
                    <div className="flex items-center">
                      <div className="w-3 h-3 rounded-full bg-blue-500 mr-3"></div>
                      <span className="text-sm font-medium text-gray-900">QR Code Scans</span>
                    </div>
                    <div className="text-right">
                      <div className="text-sm font-medium text-gray-900">{analytics.totalScans.toLocaleString()}</div>
                      <div className="text-xs text-gray-500">100%</div>
                    </div>
                  </div>
                  <div className="flex items-center justify-between py-3 border-b border-gray-100">
                    <div className="flex items-center">
                      <div className="w-3 h-3 rounded-full bg-green-500 mr-3"></div>
                      <span className="text-sm font-medium text-gray-900">Mobilní zařízení</span>
                    </div>
                    <div className="text-right">
                      <div className="text-sm font-medium text-gray-900">{analytics.scansByDevice.mobile.toLocaleString()}</div>
                      <div className="text-xs text-gray-500">{Math.round((analytics.scansByDevice.mobile / analytics.totalScans) * 100)}%</div>
                    </div>
                  </div>
                  <div className="flex items-center justify-between py-3">
                    <div className="flex items-center">
                      <div className="w-3 h-3 rounded-full bg-purple-500 mr-3"></div>
                      <span className="text-sm font-medium text-gray-900">Desktop</span>
                    </div>
                    <div className="text-right">
                      <div className="text-sm font-medium text-gray-900">{analytics.scansByDevice.desktop.toLocaleString()}</div>
                      <div className="text-xs text-gray-500">{Math.round((analytics.scansByDevice.desktop / analytics.totalScans) * 100)}%</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            {/* Top Performing Content */}
            <div className="bg-white shadow rounded-lg">
              <div className="px-6 py-5 border-b border-gray-200">
                <h3 className="text-lg leading-6 font-medium text-gray-900">Nejúspěšnější vína</h3>
              </div>
              <div className="p-6">
                <div className="space-y-4">
                  {analytics.topWines.slice(0, 5).map((wine, index) => (
                    <div key={wine.wineId} className="flex items-center justify-between py-2">
                      <div className="flex items-center">
                        <div className="w-6 h-6 bg-red-600 text-white rounded text-xs flex items-center justify-center font-medium mr-3">
                          {wine.rank}
                        </div>
                        <div>
                          <div className="text-sm font-medium text-gray-900 truncate max-w-40">{wine.wineName}</div>
                          {wine.wineVintage && (
                            <div className="text-xs text-gray-500">{wine.wineVintage}</div>
                          )}
                        </div>
                      </div>
                      <div className="text-sm font-medium text-gray-900">
                        {wine.scanCount.toLocaleString()}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </>
    );
  }

  function renderBehaviorTab() {
    return (
      <>
        <div className="mb-8">
          <h2 className="text-2xl font-bold text-gray-900 mb-6">Chování</h2>
          
          {/* Behavior Analysis */}
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            {/* Time Patterns */}
            <div className="bg-white shadow rounded-lg">
              <div className="px-6 py-5 border-b border-gray-200">
                <h3 className="text-lg leading-6 font-medium text-gray-900">Časové vzorce</h3>
              </div>
              <div className="p-6">
                <div className="h-40 flex items-end justify-between mb-6">
                  {analytics.timeDistribution.map((hour, index) => {
                    const maxCount = Math.max(...analytics.timeDistribution.map(h => h.scanCount));
                    const height = (hour.scanCount / maxCount) * 120;
                    return (
                      <div key={index} className="flex flex-col items-center flex-1">
                        <div 
                          className="w-3 bg-blue-500 rounded-t"
                          style={{ height: `${Math.max(height, 4)}px` }}
                          title={`${hour.hour}:00 - ${hour.scanCount} skenů`}
                        />
                        {index % 3 === 0 && (
                          <span className="text-xs text-gray-500 mt-2 transform -rotate-45">
                            {hour.hour}h
                          </span>
                        )}
                      </div>
                    );
                  })}
                </div>
                
                <div className="space-y-3">
                  <div className="flex justify-between items-center py-2 border-b border-gray-100">
                    <span className="text-sm text-gray-600">Nejaktivnější hodina</span>
                    <span className="text-sm font-medium text-gray-900">
                      {analytics.timeDistribution.reduce((max, hour) => 
                        hour.scanCount > max.scanCount ? hour : max
                      ).hour}:00
                    </span>
                  </div>
                  <div className="flex justify-between items-center py-2 border-b border-gray-100">
                    <span className="text-sm text-gray-600">Bounce rate</span>
                    <span className="text-sm font-medium text-gray-900">
                      {advancedMetrics?.bounceRate ? Math.round(advancedMetrics.bounceRate) : 45}%
                    </span>
                  </div>
                  <div className="flex justify-between items-center py-2">
                    <span className="text-sm text-gray-600">Avg. session duration</span>
                    <span className="text-sm font-medium text-gray-900">
                      {advancedMetrics?.avgSessionDuration || "2:45"}
                    </span>
                  </div>
                </div>
              </div>
            </div>

            {/* Content Performance */}
            <div className="bg-white shadow rounded-lg">
              <div className="px-6 py-5 border-b border-gray-200">
                <h3 className="text-lg leading-6 font-medium text-gray-900">Výkonnost obsahu</h3>
              </div>
              <div className="p-6">
                <div className="space-y-4">
                  {analytics.topWines.slice(0, 6).map((wine, index) => {
                    const engagementRate = (wine.scanCount / analytics.totalScans) * 100;
                    return (
                      <div key={wine.wineId} className="py-3 border-b border-gray-100 last:border-b-0">
                        <div className="flex items-center justify-between mb-2">
                          <div className="flex items-center">
                            <div className="w-4 h-4 bg-red-600 text-white rounded text-xs flex items-center justify-center font-medium mr-3">
                              {wine.rank}
                            </div>
                            <span className="text-sm font-medium text-gray-900 truncate max-w-32">
                              {wine.wineName}
                            </span>
                          </div>
                          <div className="text-xs text-gray-500">
                            {engagementRate.toFixed(1)}% engagement
                          </div>
                        </div>
                        <div className="w-full bg-gray-200 rounded-full h-2">
                          <div 
                            className="bg-red-600 h-2 rounded-full" 
                            style={{ width: `${Math.min(engagementRate * 2, 100)}%` }}
                          />
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          </div>

          {/* User Flow */}
          <div className="bg-white shadow rounded-lg">
            <div className="px-6 py-5 border-b border-gray-200">
              <h3 className="text-lg leading-6 font-medium text-gray-900">Uživatelský tok</h3>
            </div>
            <div className="p-6">
              <div className="text-center py-12">
                <div className="inline-flex items-center justify-center w-16 h-16 bg-blue-100 rounded-full mb-4">
                  <svg className="w-8 h-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <p className="text-lg font-medium text-gray-900 mb-2">QR Scan → Wine Page</p>
                <p className="text-sm text-gray-500">
                  {analytics.totalScans.toLocaleString()} úspěšných přechodů z QR kódů na wine stránky
                </p>
              </div>
            </div>
          </div>
        </div>
      </>
    );
  }
  // Geographic view components
  function GeographicViewToggle() {
    return (
      <div className="flex space-x-2">
        <button 
          onClick={() => setGeoView('map')}
          className={`px-3 py-1 text-sm rounded-md transition-colors ${
            geoView === 'map' 
              ? 'bg-blue-100 text-blue-700' 
              : 'text-gray-500 hover:text-gray-700 hover:bg-gray-100'
          }`}
        >
          🗺️ Mapa
        </button>
        <button 
          onClick={() => setGeoView('list')}
          className={`px-3 py-1 text-sm rounded-md transition-colors ${
            geoView === 'list' 
              ? 'bg-blue-100 text-blue-700' 
              : 'text-gray-500 hover:text-gray-700 hover:bg-gray-100'
          }`}
        >
          📋 Seznam
        </button>
      </div>
    );
  }

  function GeographicContent({ data }: { data: CountryData[] }) {
    if (geoView === 'map') {
      return (
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
          {/* World Map */}
          <div className="lg:col-span-2">
            <WorldMap data={data} />
          </div>
          
          {/* Top Countries Sidebar */}
          <div className="space-y-4">
            <div className="flex items-center justify-between">
              <h4 className="text-sm font-medium text-gray-900 uppercase tracking-wide">Top země</h4>
              <span className="text-xs text-gray-500">{data.length} zemí celkem</span>
            </div>
            <div className="space-y-3">
              {data.slice(0, 8).map((region, index) => (
                <div key={index} className="flex items-center justify-between py-2 px-3 rounded-lg hover:bg-gray-50 transition-colors">
                  <div className="flex items-center">
                    <div className="w-6 h-6 mr-3 flex items-center justify-center">
                      <span className="text-lg">{getCountryFlag(region.countryCode)}</span>
                    </div>
                    <div>
                      <div className="text-sm font-medium text-gray-900">{region.countryName}</div>
                      <div className="text-xs text-gray-500">{region.countryCode}</div>
                    </div>
                  </div>
                  <div className="text-right">
                    <div className="text-sm font-medium text-gray-900">{region.scanCount.toLocaleString()}</div>
                    <div className="text-xs text-gray-500">{region.percentage}%</div>
                  </div>
                </div>
              ))}
            </div>
            {data.length > 8 && (
              <button 
                onClick={() => setGeoView('list')}
                className="w-full text-center text-sm text-blue-600 hover:text-blue-800 py-2"
              >
                Zobrazit všech {data.length} zemí →
              </button>
            )}
          </div>
        </div>
      );
    }

    // List view
    return (
      <div className="space-y-4">
        <div className="flex items-center justify-between">
          <h4 className="text-lg font-medium text-gray-900">Všechny země</h4>
          <span className="text-sm text-gray-500">{data.length} zemí, {data.reduce((sum, c) => sum + c.scanCount, 0).toLocaleString()} skenů celkem</span>
        </div>
        
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {data.map((region, index) => (
            <div key={index} className="bg-gray-50 rounded-lg p-4 hover:bg-gray-100 transition-colors">
              <div className="flex items-center justify-between mb-3">
                <div className="flex items-center">
                  <span className="text-2xl mr-3">{getCountryFlag(region.countryCode)}</span>
                  <div>
                    <div className="font-medium text-gray-900">{region.countryName}</div>
                    <div className="text-xs text-gray-500">{region.countryCode}</div>
                  </div>
                </div>
                <div className="text-right">
                  <div className="text-lg font-bold text-gray-900">{region.scanCount.toLocaleString()}</div>
                  <div className="text-sm text-gray-500">{region.percentage}%</div>
                </div>
              </div>
              
              {/* Progress bar */}
              <div className="w-full bg-gray-200 rounded-full h-2">
                <div 
                  className="bg-red-500 h-2 rounded-full transition-all duration-300" 
                  style={{ width: `${region.percentage}%` }}
                />
              </div>
              
              <div className="mt-2 text-xs text-gray-600">
                #{index + 1} nejaktivnější země
              </div>
            </div>
          ))}
        </div>
      </div>
    );
  }

  // Helper function for country flags
  function getCountryFlag(countryCode: string): string {
    const flagMap: Record<string, string> = {
      'CZ': '🇨🇿', 'SK': '🇸🇰', 'DE': '🇩🇪', 'AT': '🇦🇹', 'US': '🇺🇸', 'GB': '🇬🇧',
      'FR': '🇫🇷', 'IT': '🇮🇹', 'ES': '🇪🇸', 'PL': '🇵🇱', 'HU': '🇭🇺', 'RO': '🇷🇴',
      'BG': '🇧🇬', 'HR': '🇭🇷', 'SI': '🇸🇮', 'RS': '🇷🇸', 'CH': '🇨🇭', 'NL': '🇳🇱',
      'BE': '🇧🇪', 'DK': '🇩🇰', 'SE': '🇸🇪', 'NO': '🇳🇴', 'FI': '🇫🇮', 'RU': '🇷🇺',
      'CN': '🇨🇳', 'JP': '🇯🇵', 'KR': '🇰🇷', 'IN': '🇮🇳', 'AU': '🇦🇺', 'CA': '🇨🇦',
      'BR': '🇧🇷', 'MX': '🇲🇽', 'AR': '🇦🇷', 'CL': '🇨🇱', 'ZA': '🇿🇦', 'TR': '🇹🇷',
      'SA': '🇸🇦', 'AE': '🇦🇪', 'SG': '🇸🇬', 'TH': '🇹🇭', 'VN': '🇻🇳', 'MY': '🇲🇾',
      'ID': '🇮🇩', 'PH': '🇵🇭', 'NZ': '🇳🇿', 'IL': '🇮🇱', 'EG': '🇪🇬', 'NG': '🇳🇬',
      'KE': '🇰🇪', 'MA': '🇲🇦', 'PE': '🇵🇪', 'CO': '🇨🇴', 'IR': '🇮🇷'
    };
    return flagMap[countryCode] || '🌍';
  }
};

// Add interface for CountryData
interface CountryData {
  countryCode: string;
  countryName: string;
  scanCount: number;
  percentage: number;
}

// Helper Components
function DeviceBreakdownItem({ label, count, total, color }: {
  label: string;
  count: number;
  total: number;
  color: string;
}) {
  const percentage = Math.round((count / total) * 100);
  
  return (
    <div className="flex items-center justify-between">
      <div className="flex items-center">
        <div className={`w-3 h-3 rounded-full mr-3 ${color}`}></div>
        <span className="text-sm text-gray-700">{label}</span>
      </div>
      <div className="flex items-center space-x-2">
        <span className="text-sm font-medium text-gray-900">{percentage}%</span>
        <span className="text-xs text-gray-500">({count.toLocaleString()})</span>
      </div>
    </div>
  );
}

function GoogleAnalyticsChart({ data }: { data: Array<{ date: string; scanCount: number }> }) {
  const maxValue = Math.max(...data.map(d => d.scanCount));
  
  return (
    <div className="w-full h-full flex items-end justify-between px-4">
      {data.slice(-14).map((item, index) => (
        <div key={index} className="flex flex-col items-center">
          <div 
            className="w-4 bg-blue-500 rounded-t"
            style={{ 
              height: `${(item.scanCount / maxValue) * 200}px`,
              minHeight: '4px'
            }}
          />
          <span className="text-xs text-gray-500 mt-2 transform -rotate-45 origin-center">
            {new Date(item.date).toLocaleDateString('cs-CZ', { month: 'short', day: 'numeric' })}
          </span>
        </div>
      ))}
    </div>
  );
}

function LoadingDisplay() {
  return (
    <div className="min-h-screen bg-gray-50 flex items-center justify-center">
      <div className="text-center">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto"></div>
        <p className="mt-4 text-gray-600">Načítání analytických dat...</p>
      </div>
    </div>
  );
}

function ErrorDisplay({ message }: { message: string }) {
  return (
    <div className="min-h-screen bg-gray-50 flex items-center justify-center">
      <div className="text-center">
        <div className="text-red-600 text-lg font-medium">{message}</div>
        <p className="mt-2 text-gray-600">Zkuste obnovit stránku</p>
      </div>
    </div>
  );
}

function NoDataDisplay() {
  return (
    <div className="min-h-screen bg-gray-50 flex items-center justify-center">
      <div className="text-center">
        <h3 className="text-lg font-medium text-gray-900">Zatím nemáme dostatek dat</h3>
        <p className="mt-2 text-gray-600">Statistiky se začnou zobrazovat po prvních skenech QR kódů</p>
      </div>
    </div>
  );
}